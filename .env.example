# Copy to .env (gitignored) and fill in locally. Never commit real keys.
# Placeholders only. The evaluator reads the environment first, then this file.

# ---------------------------------------------------------------------------------------------
# Provider: "groq" (GroqCloud Free Plan, the project default for zero cost) or "openrouter".
# ---------------------------------------------------------------------------------------------
FRAMECUE_LLM_PROVIDER=groq

# GroqCloud key (https://console.groq.com/keys). GROQ_API_KEY is also accepted for groq, and
# OPENROUTER_API_KEY for openrouter. A key is never reused across providers.
FRAMECUE_LLM_API_KEY=replace-me

# Defaults for groq. Leave unset to use them.
# FRAMECUE_LLM_ENDPOINT=https://api.groq.com/openai/v1/chat/completions
# FRAMECUE_LLM_MODEL=openai/gpt-oss-120b
# FRAMECUE_LLM_REASONING_EFFORT=low      # low | medium | high (medium costs ~1.6x tokens)
# FRAMECUE_EVAL_BATCH_SIZE=4             # 4 fits the free 8,000 tokens/minute limit at low
# FRAMECUE_LLM_MAX_OUTPUT_TOKENS=2500

# Free-tier guard: tokens this project may spend per UTC day (local ledger in runs/quota/).
# Default 180000 for groq, below the documented 200K tokens/day.
# FRAMECUE_DAILY_TOKEN_BUDGET=180000

# Groq privacy is an ORGANISATION setting: enable Zero Data Retention under
# https://console.groq.com/settings/data-controls. It cannot be verified through the API.
# Never add a payment method if the project must stay at $0: the client never requests paid
# tiers and aborts if rate limits rise above the known free-plan ceiling.

FRAMECUE_LLM_TIMEOUT_S=60
FRAMECUE_LLM_MAX_RETRIES=3

# ---------------------------------------------------------------------------------------------
# FastAPI backend (framecue serve). Comma-separated browser origins allowed by CORS.
# Default: the Vite dev server on localhost. Never use "*" for confidential runs.
# ---------------------------------------------------------------------------------------------
# FRAMECUE_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------------------------------------------------------------------------------------------
# OpenRouter only (FRAMECUE_LLM_PROVIDER=openrouter). Defaults:
#   endpoint https://openrouter.ai/api/v1/chat/completions, model google/gemini-3.1-flash-lite
# ---------------------------------------------------------------------------------------------
# Privacy routing: zero-data-retention endpoints only (default true). data_collection is always
# "deny" and cannot be configured.
# FRAMECUE_LLM_ZDR=true

# Before any content is sent, a preflight reads OpenRouter's public ZDR list and refuses models
# whose only ZDR endpoints are "Safety Retention" endpoints (flagged prompts may be retained).
# As of 2026-11-10 that includes the OpenRouter default model. Strict-ZDR, structured-output
# models found then: anthropic/claude-haiku-5.5, openai/gpt-6-luna,
# deepseek/deepseek-v4.1-flash-1017. Accepting Safety Retention weakens privacy; only set this
# deliberately.
# FRAMECUE_LLM_ALLOW_SAFETY_RETENTION=false

# Optional spending guard (OpenRouter). Requests stop once reported cost reaches this value.
# FRAMECUE_MAX_RUN_COST=1.00

# Optional prices (USD per million tokens), used ONLY for labelled OpenRouter cost estimates.
# FRAMECUE_PRICE_PROMPT_PER_MTOK=0.25
# FRAMECUE_PRICE_COMPLETION_PER_MTOK=1.50
